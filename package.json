{
  "name": "tnu-gemini-study-assistant",
  "version": "3.4.4",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "wxt prepare",
    "predev": "npm run icons",
    "dev": "wxt",
    "prebuild": "npm run icons",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:e2e:auto": "node scripts/e2e-auto.mjs",
    "test:e2e:web": "node scripts/e2e-web-tabs.mjs",
    "test:e2e:live-web": "node scripts/e2e-live-web-bridge.mjs",
    "test:e2e:scorm": "node scripts/e2e-scorm.mjs",
    "test:real-api": "node scripts/real-api-smoke.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:release": "node scripts/test-release.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.1.5",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "wxt": "^0.20.11"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
