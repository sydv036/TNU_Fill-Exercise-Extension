{"manifest_version":3,"name":"TNU Fill Exercise Assistant","description":"Hỗ trợ luyện tập Moodle TNU với Gemini API và tab Gemini, ChatGPT, Claude hoặc DeepSeek Web; có chế độ luyện đến điểm tối đa.","version":"3.5.1","icons":{"16":"icon-16.png","48":"icon-48.png","128":"icon-128.png"},"minimum_chrome_version":"114","permissions":["storage","tabs","sidePanel","notifications"],"host_permissions":["https://tnu.aum.edu.vn/*","https://gemini.google.com/*","https://chatgpt.com/*","https://chat.openai.com/*","https://claude.ai/*","https://chat.deepseek.com/*","http://127.0.0.1/*","http://localhost/*","https://generativelanguage.googleapis.com/*"],"web_accessible_resources":[{"resources":["assets/*.mjs"],"matches":["https://tnu.aum.edu.vn/*"]}],"action":{"default_title":"Mở TNU Gemini Assistant"},"side_panel":{"default_path":"sidepanel.html"},"background":{"service_worker":"background.js"},"content_scripts":[{"matches":["https://tnu.aum.edu.vn/*"],"run_at":"document_idle","js":["content-scripts/content.js"]},{"matches":["https://chat.deepseek.com/*","https://chat.openai.com/*","https://chatgpt.com/*","https://claude.ai/*","https://gemini.google.com/*"],"run_at":"document_idle","js":["content-scripts/live-web.js"]},{"matches":["https://tnu.aum.edu.vn/mod/scorm/loadSCO.php*","https://tnu.aum.edu.vn/pluginfile.php/*/mod_scorm/content/*"],"all_frames":true,"run_at":"document_start","js":["content-scripts/scorm-accelerator.js"]},{"matches":["https://tnu.aum.edu.vn/mod/scorm/loadSCO.php*","https://tnu.aum.edu.vn/pluginfile.php/*/mod_scorm/content/*"],"all_frames":true,"run_at":"document_start","js":["content-scripts/scorm-clock-main.js"],"world":"MAIN"},{"matches":["http://127.0.0.1/*","http://localhost/*"],"run_at":"document_idle","js":["content-scripts/web-fixture.js"]}]}